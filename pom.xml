<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- 多模块 parent（M5 微服务拆分）：
       统一管理 Spring Boot / Spring Cloud / Spring Cloud Alibaba 版本与插件配置。
       子模块 = seckill-common（公共层）+ 3 个业务服务 + gateway + legacy（拆分过渡用，最终删除） -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.2.5</version>
    <relativePath/>
  </parent>

  <groupId>com.seckill</groupId>
  <artifactId>seckill</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>seckill</name>
  <description>生产级秒杀系统（微服务阶段）</description>

  <modules>
    <module>seckill-common</module>
    <module>seckill-user</module>
    <module>seckill-goods</module>
    <module>seckill-seckill</module>
    <module>seckill-gateway</module>
    <module>seckill-legacy</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <!-- Spring Cloud 2023.0.x 对应 Spring Boot 3.2.x；
         Alibaba 2023.0.1.0 官方基于 SC 2023.0.1，配 2023.0.2 同代兼容 -->
    <spring-cloud.version>2023.0.2</spring-cloud.version>
    <spring-cloud-alibaba.version>2023.0.1.0</spring-cloud-alibaba.version>
    <mybatis-plus.version>3.5.7</mybatis-plus.version>
    <redisson.version>3.32.0</redisson.version>
    <rocketmq-starter.version>2.3.2</rocketmq-starter.version>
    <guava.version>33.3.1-jre</guava.version>
    <commons-lang3.version>3.17.0</commons-lang3.version>
    <testcontainers.version>2.0.5</testcontainers.version>
    <!-- jacoco 覆盖率 include 规则由各模块自行设置；默认跳过（common/gateway 无测试） -->
    <jacoco.skip>true</jacoco.skip>
    <jacoco.includes>*</jacoco.includes>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- 顺序：先 Spring Cloud，再 Alibaba（后者 BOM 覆盖 nacos-client 等版本） -->
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.alibaba.cloud</groupId>
        <artifactId>spring-cloud-alibaba-dependencies</artifactId>
        <version>${spring-cloud-alibaba.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- 三方依赖版本统一在此管理，子模块不再写版本号 -->
      <dependency>
        <groupId>com.baomidou</groupId>
        <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        <version>${mybatis-plus.version}</version>
      </dependency>
      <dependency>
        <groupId>org.redisson</groupId>
        <artifactId>redisson-spring-boot-starter</artifactId>
        <version>${redisson.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.rocketmq</groupId>
        <artifactId>rocketmq-spring-boot-starter</artifactId>
        <version>${rocketmq-starter.version}</version>
      </dependency>
      <!-- SCA BOM 会把 rocketmq-client 系列压到 5.1.4，与 starter 2.3.2（基于 5.3.1 编译）不兼容，
           必须显式钉回 5.3.1（starter 2.3.2 的传递版本） -->
      <dependency>
        <groupId>org.apache.rocketmq</groupId>
        <artifactId>rocketmq-client</artifactId>
        <version>5.3.1</version>
      </dependency>
      <dependency>
        <groupId>org.apache.rocketmq</groupId>
        <artifactId>rocketmq-common</artifactId>
        <version>5.3.1</version>
      </dependency>
      <dependency>
        <groupId>org.apache.rocketmq</groupId>
        <artifactId>rocketmq-remoting</artifactId>
        <version>5.3.1</version>
      </dependency>
      <dependency>
        <groupId>org.apache.rocketmq</groupId>
        <artifactId>rocketmq-acl</artifactId>
        <version>5.3.1</version>
      </dependency>
      <dependency>
        <groupId>com.google.guava</groupId>
        <artifactId>guava</artifactId>
        <version>${guava.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-lang3</artifactId>
        <version>${commons-lang3.version}</version>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <!-- 业务服务统一用 spring-boot-maven-plugin 打可执行 jar，排除 lombok -->
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <configuration>
            <excludes>
              <exclude>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
              </exclude>
            </excludes>
          </configuration>
        </plugin>
        <!-- jacoco：覆盖率规则按模块走（${jacoco.includes}），
             有单测的业务模块自行覆盖该属性，common/gateway 用默认 skip -->
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>0.8.12</version>
          <configuration>
            <skip>${jacoco.skip}</skip>
          </configuration>
          <executions>
            <execution>
              <goals>
                <goal>prepare-agent</goal>
              </goals>
            </execution>
            <execution>
              <id>report</id>
              <phase>test</phase>
              <goals>
                <goal>report</goal>
              </goals>
            </execution>
            <execution>
              <id>check</id>
              <phase>test</phase>
              <goals>
                <goal>check</goal>
              </goals>
              <configuration>
                <rules>
                  <rule>
                    <element>BUNDLE</element>
                    <includes>
                      <include>${jacoco.includes}</include>
                    </includes>
                    <limits>
                      <limit>
                        <counter>LINE</counter>
                        <value>COVEREDRATIO</value>
                        <minimum>0.60</minimum>
                      </limit>
                    </limits>
                  </rule>
                </rules>
              </configuration>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
